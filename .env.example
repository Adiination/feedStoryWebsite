# Copy to .env.local and fill in before deploying.

# Canonical origin. Used for sitemap.xml, canonical tags, hreflang, RSS and
# share cards. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Where DMCA notices, takedown requests and submissions land.
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com

# ---------------------------------------------------------------------------
# Advertising
#
# Google AdSense prohibits sexually explicit content, so it is not an option
# here. These are networks that accept adult traffic.
#
# Supported values: exoclick | juicyads | none
# Leave as "none" and every ad slot renders nothing in production
# (and a labelled placeholder in dev).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AD_NETWORK=none

# Zone / ad-unit id per placement, from your network's dashboard.
NEXT_PUBLIC_AD_ZONE_IN_FEED=
NEXT_PUBLIC_AD_ZONE_IN_ARTICLE=
NEXT_PUBLIC_AD_ZONE_SIDEBAR=
NEXT_PUBLIC_AD_ZONE_BANNER=

# ---------------------------------------------------------------------------
# Database (MongoDB)
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=merivasna

# ---------------------------------------------------------------------------
# Admin (/admin)
#
# ADMIN_PASSWORD is the only lock on the door — use a long random passphrase.
# Generate one:  openssl rand -base64 24
# Without it, /admin cannot be entered at all.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=

# Signs the admin session cookie. Optional: derived from ADMIN_PASSWORD if
# unset, but setting it means changing your password doesn't log you out.
# Generate:  openssl rand -hex 32
ADMIN_SESSION_SECRET=
